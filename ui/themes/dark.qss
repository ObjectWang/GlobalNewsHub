/* GlobalNewsHub — dark theme (PRD P4.7, polish pass) */

QMainWindow, QDialog {
    background: #1e1f22;
}

QLabel {
    color: #e3e5e8;
    background: transparent;
}

QGroupBox {
    border: 1px solid #3a3d42;
    border-radius: 8px;
    margin-top: 10px;
    color: #cfd2d6;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ---- news list: card-like rows -------------------------------------- */
QListView {
    background: #242629;
    color: #e3e5e8;
    border: 1px solid #33363b;
    border-radius: 8px;
    padding: 4px;
}
QListView::item {
    padding: 7px 9px;
    margin: 2px 3px;
    border-radius: 6px;
    border-left: 3px solid transparent;
}
QListView::item:hover {
    background: #2c2f34;
    border-left-color: #4a7fd0;
}
QListView::item:selected {
    background: #2f6fdb;
    color: #ffffff;
    border-left-color: #9cc0ff;
}

/* ---- inputs ---------------------------------------------------------- */
QLineEdit, QSpinBox, QComboBox, QTextBrowser {
    background: #2a2d31;
    color: #e3e5e8;
    border: 1px solid #45494f;
    border-radius: 6px;
    padding: 4px 6px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #2f6fdb;
}
QTextBrowser {
    padding: 10px 12px;
}
QComboBox QAbstractItemView {
    background: #2a2d31;
    selection-background-color: #2f6fdb;
    selection-color: #ffffff;
}

QPushButton, QDialogButtonBox QPushButton {
    background: #34373c;
    border: 1px solid #45494f;
    border-radius: 6px;
    padding: 5px 16px;
    color: #e3e5e8;
}
QPushButton:hover {
    background: #3d4046;
    border-color: #565b62;
}
QPushButton:pressed {
    background: #46494f;
}

/* ---- chrome ----------------------------------------------------------- */
QStatusBar {
    background: #26282c;
    color: #a8adb4;
}
QMenuBar {
    background: #26282c;
    color: #e3e5e8;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #3a3d42;
}
QMenu {
    background: #26282c;
    border: 1px solid #3a3d42;
    border-radius: 6px;
    padding: 4px;
    color: #e3e5e8;
}
QMenu::item {
    padding: 5px 22px 5px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #2f6fdb;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #3a3d42;
    margin: 3px 6px;
}

/* ---- slim scrollbars --------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #4a4e55;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #5c6068;
}
QScrollBar:horizontal {
    background: transparent;
    height: 9px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #4a4e55;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0; height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolTip {
    background: #0f1012;
    color: #e3e5e8;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QSplitter::handle {
    width: 3px;
    background: transparent;
}
QSplitter::handle:hover {
    background: #2f6fdb;
}

QTableWidget {
    background: #242629;
    alternate-background-color: #282b2f;
    gridline-color: #33363b;
    color: #e3e5e8;
    border: 1px solid #33363b;
    border-radius: 6px;
}
QTableWidget::item:selected {
    background: #2f6fdb;
    color: #ffffff;
}
