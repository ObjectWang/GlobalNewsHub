/* GlobalNewsHub — dark theme (PRD P4.7) */

QMainWindow, QDialog {
    background: #1e1f22;
}

QLabel {
    color: #e3e5e8;
}

QGroupBox {
    border: 1px solid #3a3d42;
    border-radius: 6px;
    margin-top: 10px;
    color: #cfd2d6;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QListView {
    background: #242629;
    alternate-background-color: #282b2f;
    color: #e3e5e8;
}
QListView::item:selected {
    background: #2f6fdb;
    color: #ffffff;
}

QLineEdit, QSpinBox, QComboBox, QTextBrowser {
    background: #2a2d31;
    color: #e3e5e8;
    border: 1px solid #45494f;
    border-radius: 4px;
    padding: 3px;
}

QPushButton, QDialogButtonBox QPushButton {
    background: #34373c;
    border: 1px solid #45494f;
    border-radius: 4px;
    padding: 4px 14px;
    color: #e3e5e8;
}
QPushButton:hover {
    background: #3d4046;
}

QStatusBar {
    background: #26282c;
    color: #a8adb4;
}

QMenuBar {
    background: #26282c;
    color: #e3e5e8;
}
QMenuBar::item:selected {
    background: #3a3d42;
}
