/* GlobalNewsHub — light theme (PRD P4.7, polish pass) */

QMainWindow, QDialog {
    background: #f5f6f8;
}

QLabel {
    color: #1c1e21;
    background: transparent;
}

QGroupBox {
    border: 1px solid #d0d3d8;
    border-radius: 8px;
    margin-top: 10px;
    color: #333;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ---- news list: card-like rows -------------------------------------- */
QListView {
    background: #ffffff;
    color: #1c1e21;
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    padding: 4px;
}
QListView::item {
    padding: 7px 9px;
    margin: 2px 3px;
    border-radius: 6px;
    border-left: 3px solid transparent;
}
QListView::item:hover {
    background: #eef2f8;
    border-left-color: #9db9dd;
}
QListView::item:selected {
    background: #1667d9;
    color: #ffffff;
    border-left-color: #0d3f85;
}

/* ---- inputs ---------------------------------------------------------- */
QLineEdit, QSpinBox, QComboBox, QTextBrowser {
    background: #ffffff;
    color: #1c1e21;
    border: 1px solid #c9ccd1;
    border-radius: 6px;
    padding: 4px 6px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #1667d9;
}
QTextBrowser {
    padding: 10px 12px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    selection-background-color: #1667d9;
    selection-color: #ffffff;
}

QPushButton, QDialogButtonBox QPushButton {
    background: #e8eaed;
    border: 1px solid #c9ccd1;
    border-radius: 6px;
    padding: 5px 16px;
}
QPushButton:hover {
    background: #dde0e5;
    border-color: #b4b9c0;
}
QPushButton:pressed {
    background: #d0d4da;
}

/* ---- chrome ----------------------------------------------------------- */
QStatusBar {
    background: #eceef1;
    color: #555;
}
QMenuBar {
    background: #eceef1;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #d5dae1;
}
QMenu {
    background: #ffffff;
    border: 1px solid #d0d3d8;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px 5px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #1667d9;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #e3e5e8;
    margin: 3px 6px;
}

/* ---- slim scrollbars --------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c3c8cf;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #a8aeb6;
}
QScrollBar:horizontal {
    background: transparent;
    height: 9px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c3c8cf;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0; height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolTip {
    background: #2a2d31;
    color: #f0f2f5;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QSplitter::handle {
    width: 3px;
    background: transparent;
}
QSplitter::handle:hover {
    background: #1667d9;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f7f8fa;
    gridline-color: #eceef1;
    border: 1px solid #e3e5e8;
    border-radius: 6px;
}
QTableWidget::item:selected {
    background: #1667d9;
    color: #ffffff;
}
